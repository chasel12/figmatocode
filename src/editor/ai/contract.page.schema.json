{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "AiBorderSpec": {
      "properties": {
        "color": {
          "type": "string"
        },
        "gradient": {
          "$ref": "#/definitions/AiGradientSpec",
          "description": "设置即走渐变描边（三端原生支持），此时 color 仅作降级回退"
        },
        "style": {
          "enum": [
            "solid",
            "dashed",
            "dotted"
          ],
          "type": "string"
        },
        "width": {
          "type": "number"
        }
      },
      "required": [
        "width",
        "color"
      ],
      "type": "object",
      "additionalProperties": false
    },
    "AiDecorationSpec": {
      "properties": {
        "at": {
          "description": "SPOTLIGHT 光源位置（百分比，可负）",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          },
          "required": [
            "x",
            "y"
          ],
          "type": "object",
          "additionalProperties": false
        },
        "color": {
          "description": "主色：hex 或令牌引用",
          "type": "string"
        },
        "cut": {
          "description": "DIAGONAL_CUT 切角像素（四角同值）",
          "type": "number"
        },
        "intensity": {
          "description": "强度 0-1，缺省 1",
          "type": "number"
        },
        "kind": {
          "enum": [
            "SPOTLIGHT",
            "VIGNETTE",
            "MESH_GRADIENT",
            "DIAGONAL_CUT",
            "DUOTONE"
          ],
          "type": "string"
        },
        "points": {
          "description": "MESH_GRADIENT 的色斑（2~4 个）",
          "items": {
            "$ref": "#/definitions/AiMeshPoint"
          },
          "type": "array"
        },
        "stop": {
          "description": "衰减起止（百分比）",
          "properties": {
            "from": {
              "type": "number"
            },
            "to": {
              "type": "number"
            }
          },
          "required": [
            "from",
            "to"
          ],
          "type": "object",
          "additionalProperties": false
        }
      },
      "required": [
        "kind"
      ],
      "type": "object",
      "additionalProperties": false
    },
    "AiEffectSpec": {
      "description": "模型可表达的效果（阴影/模糊三档，其余效果不在表达范围）",
      "properties": {
        "blur": {
          "type": "number"
        },
        "color": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "DROP_SHADOW",
            "INNER_SHADOW",
            "LAYER_BLUR"
          ],
          "type": "string"
        },
        "radius": {
          "type": "number"
        },
        "spread": {
          "type": "number"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object",
      "additionalProperties": false
    },
    "AiGradientSpec": {
      "description": "B1 渐变（描边用；from/to 走 applyColor，故支持令牌引用）",
      "properties": {
        "angle": {
          "description": "Figma 向量角 deg（0=向右、顺时针）；缺省 90 = 自上而下",
          "type": "number"
        },
        "from": {
          "description": "起点色：hex 或令牌引用",
          "type": "string"
        },
        "to": {
          "description": "终点色：hex 或令牌引用",
          "type": "string"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "type": "object",
      "additionalProperties": false
    },
    "AiGridSpec": {
      "description": "B3 CSS Grid（设置即接管容器布局，flex 语义失效）",
      "properties": {
        "autoFlow": {
          "enum": [
            "row",
            "column",
            "row dense",
            "column dense"
          ],
          "type": "string"
        },
        "columnGap": {
          "type": "number"
        },
        "columns": {
          "description": "grid-template-columns 原值，如 repeat(3, 1fr)",
          "type": "string"
        },
        "rowGap": {
          "type": "number"
        },
        "rows": {
          "type": "string"
        }
      },
      "type": "object",
      "additionalProperties": false
    },
    "AiLayoutSpec": {
      "properties": {
        "align": {
          "enum": [
            "START",
            "CENTER",
            "END",
            "STRETCH",
            "BASELINE"
          ],
          "type": "string"
        },
        "gap": {
          "description": "主轴间距 px",
          "type": "number"
        },
        "height": {
          "type": "number"
        },
        "heightMode": {
          "enum": [
            "FIXED",
            "FILL",
            "HUG"
          ],
          "type": "string"
        },
        "justify": {
          "enum": [
            "START",
            "CENTER",
            "END",
            "SPACE_BETWEEN"
          ],
          "type": "string"
        },
        "mode": {
          "description": "布局模式：纵向堆叠 / 横向排列 / 绝对定位",
          "enum": [
            "VERTICAL",
            "HORIZONTAL",
            "ABSOLUTE"
          ],
          "type": "string"
        },
        "padding": {
          "description": "内边距 [上,右,下,左]，单位 px（8pt 网格）",
          "items": {
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array"
        },
        "width": {
          "type": "number"
        },
        "widthMode": {
          "enum": [
            "FIXED",
            "FILL",
            "HUG"
          ],
          "type": "string"
        },
        "x": {
          "description": "ABSOLUTE 容器内子项的坐标",
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "type": "object",
      "additionalProperties": false
    },
    "AiMeshPoint": {
      "description": "B1 装饰：与 `schema/types.ts` 的 `DecorationSpec` 同枚举，但收窄到 AI 该管的字段",
      "properties": {
        "color": {
          "description": "hex 或令牌引用",
          "type": "string"
        },
        "radius": {
          "description": "半径占长边百分比 0-100",
          "type": "number"
        },
        "x": {
          "description": "0-100",
          "type": "number"
        },
        "y": {
          "description": "0-100",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "radius",
        "color"
      ],
      "type": "object",
      "additionalProperties": false
    },
    "AiNodeKind": {
      "description": "模型可创建的节点类型（PAGE/SECTION/SLICE/STAR/POLYGON 不在 AI 表达范围）",
      "enum": [
        "FRAME",
        "TEXT",
        "BUTTON",
        "RECTANGLE",
        "IMAGE",
        "OVAL",
        "LINE",
        "VECTOR"
      ],
      "type": "string"
    },
    "AiNodeSpec": {
      "properties": {
        "children": {
          "items": {
            "$ref": "#/definitions/AiNodeSpec"
          },
          "type": "array"
        },
        "icon": {
          "description": "VECTOR 图标：风格包图标库名（如 \"house\"）；与 vectorD 二选一",
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/AiNodeKind"
        },
        "layout": {
          "$ref": "#/definitions/AiLayoutSpec"
        },
        "name": {
          "description": "图层名（用于人读与后续编辑定位，建议语义化中文/英文短语）",
          "type": "string"
        },
        "src": {
          "description": "IMAGE 的图片地址（可为空占位）",
          "type": "string"
        },
        "style": {
          "$ref": "#/definitions/AiStyleSpec"
        },
        "text": {
          "description": "TEXT/BUTTON 的文案",
          "type": "string"
        },
        "vectorD": {
          "description": "VECTOR 自定义路径（SVG path d，24×24 坐标系）",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object",
      "additionalProperties": false
    },
    "AiStateStyle": {
      "description": "B2 交互态单态：只允许视觉字段（与 `StateStyleSchema` 同口径，收窄掉 decorations/points）",
      "properties": {
        "background": {
          "description": "填充色：hex 或令牌引用",
          "type": "string"
        },
        "border": {
          "$ref": "#/definitions/AiBorderSpec"
        },
        "borderRadius": {
          "type": "number"
        },
        "color": {
          "description": "文本色：hex 或令牌引用",
          "type": "string"
        },
        "effects": {
          "items": {
            "$ref": "#/definitions/AiEffectSpec"
          },
          "type": "array"
        },
        "opacity": {
          "description": "0-1",
          "type": "number"
        }
      },
      "type": "object",
      "additionalProperties": false
    },
    "AiStatesSpec": {
      "properties": {
        "active": {
          "$ref": "#/definitions/AiStateStyle"
        },
        "disabled": {
          "$ref": "#/definitions/AiStateStyle"
        },
        "focus": {
          "$ref": "#/definitions/AiStateStyle"
        },
        "hover": {
          "$ref": "#/definitions/AiStateStyle"
        }
      },
      "type": "object",
      "additionalProperties": false
    },
    "AiStyleSpec": {
      "properties": {
        "background": {
          "description": "填充色：hex 或",
          "type": "string"
        },
        "border": {
          "$ref": "#/definitions/AiBorderSpec"
        },
        "borderRadius": {
          "type": "number"
        },
        "color": {
          "description": "文本/图标色：hex 或",
          "type": "string"
        },
        "decorations": {
          "description": "B1 装饰层（只补 fills/effects 表达不了的视觉）",
          "items": {
            "$ref": "#/definitions/AiDecorationSpec"
          },
          "type": "array"
        },
        "effects": {
          "items": {
            "$ref": "#/definitions/AiEffectSpec"
          },
          "type": "array"
        },
        "fontSize": {
          "type": "number"
        },
        "fontWeight": {
          "type": "number"
        },
        "grid": {
          "$ref": "#/definitions/AiGridSpec",
          "description": "B3 CSS Grid"
        },
        "letterSpacing": {
          "type": "number"
        },
        "lineHeight": {
          "type": "number"
        },
        "opacity": {
          "type": "number"
        },
        "states": {
          "$ref": "#/definitions/AiStatesSpec",
          "description": "B2 交互态：出码成伪类，画布不预览"
        },
        "textAlign": {
          "enum": [
            "left",
            "center",
            "right",
            "justify"
          ],
          "type": "string"
        },
        "transform": {
          "$ref": "#/definitions/AiTransformSpec",
          "description": "B3 元素级变换"
        }
      },
      "type": "object",
      "additionalProperties": false
    },
    "AiTransformSpec": {
      "description": "B3 元素级变换（缺省绕元素中心；顺序 translate → rotate → scale）",
      "properties": {
        "origin": {
          "description": "CSS transform-origin，缺省 50% 50%",
          "type": "string"
        },
        "rotate": {
          "type": "number"
        },
        "scaleX": {
          "type": "number"
        },
        "scaleY": {
          "type": "number"
        },
        "translateX": {
          "type": "number"
        },
        "translateY": {
          "type": "number"
        }
      },
      "type": "object",
      "additionalProperties": false
    }
  },
  "description": "由 scripts/gen-ai-schema.mjs 从 src/editor/ai/types.ts 自动生成，请勿手改。",
  "properties": {
    "background": {
      "description": "页面底色：hex 或",
      "type": "string"
    },
    "height": {
      "description": "视口高（缺省 812）",
      "type": "number"
    },
    "kind": {
      "const": "page",
      "type": "string"
    },
    "name": {
      "description": "页面名（中文短语）",
      "type": "string"
    },
    "root": {
      "$ref": "#/definitions/AiNodeSpec",
      "description": "页面内容根：其 children 成为 PAGE 的直接子项，layout 的 padding/gap/align 落到 PAGE 根"
    },
    "width": {
      "description": "视口宽（缺省 375）",
      "type": "number"
    }
  },
  "required": [
    "kind",
    "name",
    "root"
  ],
  "type": "object",
  "title": "UI Compiler AI · 页面草稿契约",
  "additionalProperties": false
}
