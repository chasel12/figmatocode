{
  "name": "ui-compiler",
  "private": true,
  "version": "0.1.0",
  "description": "UI Compiler - 结构化 UI 编译平台：UI AST → Layout Compiler → Taro/HTML → Pixel Diff",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "preview": "vite preview",
    "test": "node scripts/vitest-run.mjs",
    "pages": "npx vite-node scripts/build-pages.ts && node scripts/assert-pages.mjs",
    "shot": "node scripts/screenshot.mjs",
    "diff": "node scripts/diff.mjs",
    "viewport": "node scripts/viewport-check.mjs",
    "precanvasdiff": "vite-node scripts/build-e2e-hook.ts",
    "canvasdiff": "node scripts/canvas-diff.mjs",
    "walkthrough": "node scripts/walkthrough.mjs",
    "fr60": "node scripts/fr60-guard-check.mjs",
    "showcase": "node scripts/showcase.mjs",
    "perf-1000": "node scripts/perf-1000.mjs",
    "zip-assert": "vite-node scripts/zip-assert.mjs",
    "zip-file-verify": "node scripts/zip-file-verify.mjs",
    "audit-params": "node scripts/audit-params.mjs",
    "audit-params-deep": "node scripts/audit-params-deep.mjs",
    "user-flow": "node scripts/user-flow.mjs",
    "deploy-check": "node scripts/deploy-check.mjs",
    "ci-local": "node scripts/ci-local.mjs",
    "demo-report": "node scripts/demo-report.mjs",
    "smoke-m1": "node scripts/m1-smoke.mjs",
    "smoke-m2": "node scripts/m2-smoke.mjs",
    "present-smoke": "node scripts/present-smoke.mjs",
    "e2e": "npm run pages && npm run shot && npm run diff",
    "ai:schema": "node scripts/gen-ai-schema.mjs",
    "ai:tokens": "node scripts/extract-tokens.mjs",
    "ai:icons": "node scripts/icons-import.mjs",
    "ai:fewshots": "vite-node scripts/extract-fewshots.ts",
    "ai:baseline": "vite-node scripts/ai-baseline.ts",
    "ai:baseline:check": "vite-node scripts/ai-baseline.ts --check",
    "ai:assets": "npm run ai:tokens && npm run ai:icons && npm run ai:fewshots",
    "ai-matrix": "vite-node scripts/ai-matrix.ts",
    "codegen:react": "vite-node scripts/codegen.ts --target react",
    "codegen:vue": "vite-node scripts/codegen.ts --target vue",
    "codegen:taro": "vite-node scripts/codegen.ts --target taro",
    "codegen:all": "vite-node scripts/codegen.ts --target all",
    "codegen:verify": "node scripts/codegen-verify.mjs --target all --allow-miss taro:1",
    "codegen:verify:react": "node scripts/codegen-verify.mjs --target react",
    "codegen:verify:vue": "node scripts/codegen-verify.mjs --target vue",
    "codegen:verify:taro": "node scripts/codegen-verify.mjs --target taro --allow-miss taro:1",
    "bundle:verify": "vite-node scripts/bundle-verify.ts",
    "bundle:e2e": "node scripts/export-bundle-e2e.mjs",
    "nav:e2e": "vite-node scripts/nav-e2e.ts",
    "fig:check": "vite-node scripts/fig-check.ts",
    "standards:check": "vite-node scripts/standards-check.ts",
    "standards:a11y": "vite-node scripts/standards-a11y.ts",
    "standards": "npm run standards:check && npm run standards:a11y",
    "ui:audit": "vite-node scripts/ui-audit.ts",
    "ui:audit:baseline": "vite-node scripts/ui-audit.ts --baseline",
    "ui:gen": "vite-node scripts/ui-gen.ts",
    "ui:shots": "vite-node scripts/ui-shots.ts",
    "ui:measure": "vite-node scripts/ui-measure.ts",
    "ui:expect": "vite-node scripts/ui-expect.ts",
    "showcase:gen": "vite-node scripts/gen-showcase.ts",
    "recovery": "node scripts/recovery-check.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@open-pencil/kiwi": "^0.16.0",
    "ajv": "^8.20.0",
    "culori": "^4.0.2",
    "konva": "^9.3.16",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.13"
  },
  "devDependencies": {
    "@radix-ui/colors": "^3.0.0",
    "@types/node": "^26.6.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "^4.14.0",
    "daisyui": "^5.7.50",
    "lucide-static": "^0.470.0",
    "open-props": "^1.7.23",
    "pixelmatch": "^5.3.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "ts-json-schema-generator": "^2.9.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
